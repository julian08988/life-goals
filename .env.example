# Copy to .env and fill in. Never commit .env (it is gitignored).
# All keys are optional: without them the app runs fully offline on the MockGuide
# and device text-to-speech.

# Anthropic: reasoning for the guide (Talk It Through, interview distillation, review).
EXPO_PUBLIC_ANTHROPIC_API_KEY=
EXPO_PUBLIC_ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI: Whisper speech-to-text and TTS for the guide's voice.
EXPO_PUBLIC_OPENAI_API_KEY=
EXPO_PUBLIC_OPENAI_TTS_VOICE=alloy

# Optional: route provider calls through your own proxy instead of calling vendors
# directly from the phone. When set, the API keys above are not needed on-device.
EXPO_PUBLIC_GUIDE_PROXY_URL=
