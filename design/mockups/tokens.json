{
  "name": "Life Goals design tokens",
  "version": "1.0.0",
  "updated": "2026-11-18",
  "notes": [
    "Dark-first, one accent, typography-led. Values are logical points (iPhone 15 Pro: 393x852).",
    "The Expo build imports this file; src/ui/theme.ts should mirror it one to one.",
    "No red, no success green, no warning amber anywhere: state is carried by brightness and position, not hue."
  ],
  "color": {
    "background": "#07080B",
    "surface": "#0E1016",
    "surfaceRaised": "#151822",
    "hairline": "rgba(255,255,255,0.08)",
    "hairlineStrong": "rgba(255,255,255,0.14)",
    "text": "#F2F3F5",
    "textMuted": "rgba(242,243,245,0.62)",
    "textFaint": "rgba(242,243,245,0.38)",
    "textGhost": "rgba(242,243,245,0.22)",
    "accent": "#9FD3FF",
    "accentDeep": "#4FA3E3",
    "accentGlow": "rgba(159,211,255,0.16)",
    "accentHalo": "rgba(159,211,255,0.32)",
    "onAccent": "#07080B",
    "thread": "rgba(79,163,227,0.55)",
    "threadLit": "#9FD3FF"
  },
  "type": {
    "family": "Inter",
    "familyFallback": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', Roboto, system-ui, sans-serif",
    "scale": {
      "display": { "size": 40, "lineHeight": 46, "weight": 300, "letterSpacing": -1.0 },
      "title": { "size": 28, "lineHeight": 34, "weight": 400, "letterSpacing": -0.6 },
      "heading": { "size": 21, "lineHeight": 28, "weight": 400, "letterSpacing": -0.3 },
      "spoken": { "size": 26, "lineHeight": 33, "weight": 300, "letterSpacing": -0.5 },
      "body": { "size": 17, "lineHeight": 25, "weight": 400, "letterSpacing": 0 },
      "small": { "size": 14, "lineHeight": 20, "weight": 400, "letterSpacing": 0 },
      "label": { "size": 12, "lineHeight": 16, "weight": 500, "letterSpacing": 1.2, "transform": "uppercase" },
      "micro": { "size": 10, "lineHeight": 12, "weight": 500, "letterSpacing": 1.0, "transform": "uppercase" }
    },
    "minimumBody": 17
  },
  "spacing": { "xxs": 2, "xs": 4, "sm": 8, "md": 16, "lg": 24, "xl": 40, "xxl": 64, "screenInset": 24 },
  "radius": { "sm": 10, "md": 16, "lg": 24, "pill": 999 },
  "elevation": {
    "none": "none",
    "glow": "0 0 40px rgba(159,211,255,0.16)",
    "haloListening": "0 0 56px rgba(159,211,255,0.32), inset 0 0 24px rgba(159,211,255,0.10)",
    "haloSpeaking": "0 0 72px rgba(159,211,255,0.40), inset 0 0 36px rgba(159,211,255,0.22)"
  },
  "motion": {
    "quick": { "duration": 220, "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)" },
    "breathe": { "duration": 700, "easing": "cubic-bezier(0.4, 0, 0.2, 1)" },
    "settle": { "duration": 800, "easing": "cubic-bezier(0.16, 1, 0.3, 1)" },
    "breathCycle": { "duration": 4000, "easing": "ease-in-out", "note": "Halo listening state; one in, one out." },
    "threadDraw": { "duration": 600, "easing": "cubic-bezier(0.16, 1, 0.3, 1)", "stagger": 70, "note": "Thread nodes light bottom-up when a priority is opened." },
    "textReveal": { "duration": 400, "easing": "ease-out", "note": "The spoken sentence fades in word by word, no bounce." },
    "rule": "Motion breathes, never bounces. No spring overshoot anywhere."
  },
  "haptics": { "breathCue": "light", "confirm": "medium", "reframe": "soft", "rule": "Only on breath cue, confirm and reframe." },
  "components": {
    "halo": {
      "description": "The voice element. One thin ring with a soft inner glow. It replaces every waveform.",
      "sizes": { "inline": 12, "small": 56, "medium": 96, "large": 136 },
      "states": {
        "idle": { "ring": "rgba(79,163,227,0.55)", "ringWidth": 1, "glow": "none", "motion": "none" },
        "listening": { "ring": "#9FD3FF", "ringWidth": 1.5, "glow": "haloListening", "motion": "breathCycle; a second ring at 0.25 opacity trails the breath" },
        "thinking": { "ring": "rgba(159,211,255,0.4)", "ringWidth": 1, "glow": "glow", "motion": "a 90-degree brighter arc rotates once per 2.4 s" },
        "speaking": { "ring": "#9FD3FF", "ringWidth": 1.5, "glow": "haloSpeaking", "motion": "steady; inner glow tracks speech amplitude between 0.7 and 1.0" }
      }
    },
    "thread": {
      "description": "The hierarchy as one vertical line. The node in play is filled; ancestors are outlined; the scene sentence is the faint end point.",
      "rail": 12,
      "dot": 8,
      "lineWidth": 1,
      "order": "bottom-up: today, this week, this month, 6 months, 1 year, 5 years, life goal, your words"
    },
    "confidenceTag": {
      "strong": { "border": "#9FD3FF", "background": "rgba(159,211,255,0.16)" },
      "moderate": { "border": "rgba(242,243,245,0.38)", "background": "transparent" },
      "emerging": { "border": "rgba(255,255,255,0.08)", "background": "transparent" }
    },
    "button": { "height": 52, "compactHeight": 40, "radius": 999, "labelSize": 15, "labelWeight": 500 },
    "switch": { "width": 51, "height": 31, "onTrack": "#4FA3E3", "offTrack": "#151822" },
    "tabBar": { "height": 72, "items": 3, "indicator": "6px dot above an uppercase label; no icons" }
  }
}
